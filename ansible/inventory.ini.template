# Ansible Inventory Template
# After running terraform apply, get the IPs from: terraform output ansible_inventory
# Or run: terraform output -raw ansible_inventory > ansible/inventory.ini

[web_servers]
# Add your EC2 instance public IPs here
# Example:
# 54.123.45.67 ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/ssm-key.pem
# 54.123.45.68 ansible_user=ec2-user ansible_ssh_private_key_file=~/.ssh/ssm-key.pem

[web_servers:vars]
ansible_python_interpreter=/usr/bin/python3
